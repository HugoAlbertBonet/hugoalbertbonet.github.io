---
// "Favorite projects" tile: blue slides are professional (link to the role in Experience),
// orange slides are personal (link to the project page). The link sits in the controls row and follows
// the current slide, so the preview gets the room; the preview itself links there too.
import { getCarouselSlides, initialOf } from '../lib/content';

const slides = await getCarouselSlides();
const base = import.meta.env.BASE_URL;
const isVideo = (src: string) => /\.(mp4|webm)$/i.test(src);
const linkOf = (s: (typeof slides)[number]) =>
  s.kind === 'pro'
    ? { href: `#experience-${s.experienceId}`, text: 'See it in Experience ↓', label: `See ${s.name} in Experience`, jump: true }
    : { href: `${base}projects/${s.slug}/`, text: 'Open project →', label: `Open project: ${s.name}`, jump: false };
const first = slides[0] && linkOf(slides[0]);
---

<div
  class:list={['tile', 'carousel', slides[0]?.kind]}
  role="region"
  aria-roledescription="carousel"
  aria-label="Favorite projects"
  data-carousel
>
  {
    slides.map((s, i) => {
      const media = s.kind === 'pro' ? s.media : (s.preview ?? s.cover);
      const poster = s.kind === 'personal' && s.preview ? s.cover : undefined;
      const position = s.kind === 'personal' && s.coverPosition ? `object-position: ${s.coverPosition}` : undefined;
      const link = linkOf(s);
      return (
        <article
          class="slide"
          data-kind={s.kind}
          data-href={link.href}
          data-cta={link.text}
          data-cta-label={link.label}
          data-cta-jump={link.jump ? 'true' : 'false'}
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}`}
          hidden={i !== 0}
        >
          <div class="top">
            <span class="tile-label">
              Favorite projects <span class="pos">· {i + 1} / {slides.length}</span>
            </span>
            <span class="pill">{s.kind === 'pro' ? `Professional · ${s.org}` : 'Personal project'}</span>
          </div>
          <a class="well" href={link.href} data-jump={link.jump ? '' : undefined} tabindex="-1" aria-hidden="true">
            {media ? (
              isVideo(media) ? (
                <video src={media} poster={poster} style={position} muted loop playsinline preload={i === 0 ? 'auto' : 'none'} aria-hidden="true" />
              ) : (
                <img src={media} style={position} alt="" loading="lazy" />
              )
            ) : (
              <span class="well-mark" aria-hidden="true">
                {initialOf(s.name)}
              </span>
            )}
          </a>
          <div class="text">
            <h3 class="name">{s.name}</h3>
            <p class="line">{s.line}</p>
          </div>
        </article>
      );
    })
  }

  <div class="controls">
    <div class="dots">
      {
        slides.map((_, i) => (
          <button type="button" class="dot" aria-label={`Show project ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} data-dot={i} />
        ))
      }
    </div>
    {
      first && (
        <a class="cta tap" href={first.href} aria-label={first.label} data-jump={first.jump ? '' : undefined} data-cta-link>
          {first.text}
        </a>
      )
    }
    <div class="arrows">
      <button type="button" class="arrow" aria-label="Previous project" data-prev>←</button>
      <button type="button" class="arrow" aria-label="Next project" data-next>→</button>
    </div>
  </div>
</div>

<style>
  .carousel {
    --slide-bg: var(--blue);
    --well: var(--blue-hover);
    --well-line: var(--blue-well-line);
    --pill-bg: var(--on-accent);
    --pill-fg: var(--blue-deep);
    --slide-fg: var(--on-accent);
    --slide-soft: var(--on-blue-soft);
    position: relative;
    gap: 14px;
    padding: 18px;
    background: var(--slide-bg);
    border-color: var(--slide-bg);
    color: var(--slide-fg);
  }

  .carousel.personal {
    --slide-bg: var(--orange);
    --well: var(--orange-well);
    --well-line: var(--orange-well-line);
    --pill-bg: var(--graphite);
    --pill-fg: var(--on-accent);
  }

  .slide {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    animation: fadein 0.25s ease-out;
  }

  .slide[hidden] {
    display: none;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .top .tile-label {
    font-size: 10.5px;
    line-height: 1.4;
    color: inherit;
    opacity: 0.8;
  }

  .pos {
    white-space: nowrap;
  }

  .pill {
    flex: none;
    padding: 4px 9px;
    border-radius: var(--radius-pill);
    background: var(--pill-bg);
    color: var(--pill-fg);
    font-size: 11px;
    font-weight: 600;
  }

  .well {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 150px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--well);
    border: 1px dashed var(--well-line);
    font-size: 12px;
    color: var(--slide-soft);
    text-align: center;
    text-decoration: none;
    padding: 0 12px;
  }

  /* No preview yet: dot pattern with the project's initial. */
  .well:not(:has(img, video)) {
    justify-content: flex-start;
    align-items: flex-end;
    padding: 10px 14px;
    background-image: radial-gradient(color-mix(in srgb, var(--on-accent) 22%, transparent) 1.2px, transparent 1.4px);
    background-size: 12px 12px;
  }

  .well-mark {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
    color: var(--on-accent);
    opacity: 0.85;
  }

  .well img,
  .well video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .well:has(img, video) {
    padding: 0;
    border-style: solid;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
  }

  .line {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.88;
  }

  /* The link for the current slide, between the dots and the arrows. */
  .cta {
    flex: none;
    padding-bottom: 1px;
    border-bottom: 1.5px solid currentColor;
    color: inherit;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover {
    color: inherit;
    border-bottom-width: 2.5px;
  }

  .carousel :focus-visible {
    outline-color: currentColor;
  }

  .controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  /* 8px dot inside a 24px tap target. */
  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    padding: 0;
    border: 1.5px solid currentColor;
    border-radius: var(--radius-pill);
    background: transparent;
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .dot[aria-current='true'] {
    width: 22px;
    background: currentColor;
  }

  .arrows {
    display: none;
    gap: 8px;
  }

  .arrow {
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, currentColor 18%, transparent);
    color: inherit;
    font-size: 18px;
    transition: background-color 0.15s ease;
  }

  .arrow:hover {
    background: color-mix(in srgb, currentColor 28%, transparent);
  }

  @media (min-width: 960px) {
    /* Tight spacing under the text and around the controls, so the preview gets the height. */
    .carousel {
      gap: 6px;
      padding: 24px 24px 18px;
    }

    /* Fixed-height tile: the slide takes what's left above the controls, and the preview
       shrinks first, so the arrows and dots never get pushed out. */
    .slide {
      flex: 1 1 0;
      min-height: 0;
      overflow: hidden;
    }

    .well {
      flex: 1 1 96px;
      min-height: 0;
      height: auto;
    }

    .name,
    .line {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    .controls {
      flex: none;
    }

    .top {
      gap: 12px;
    }

    .top .tile-label {
      font-size: 11px;
    }

    .pill {
      padding: 5px 10px;
      font-size: 12px;
    }

    .well:not(:has(img, video)) {
      opacity: 0.9;
    }

    .text {
      gap: 4px;
    }

    .name {
      font-size: 28px;
    }

    .line {
      font-size: 15px;
    }

    .arrows {
      display: flex;
    }
  }

  @keyframes fadein {
    from { opacity: 0.3; }
    to { opacity: 1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const cta = root.querySelector<HTMLAnchorElement>('[data-cta-link]');
    let current = 0;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Previews play only while their slide shows, and never by themselves with reduced motion.
    const syncVideos = () =>
      slides.forEach((s, j) => {
        const v = s.querySelector('video');
        if (!v) return;
        if (j === current && !reduceMotion) v.play().catch(() => {});
        else v.pause();
      });

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, j) => (s.hidden = j !== current));
      syncVideos();
      dots.forEach((d, j) => (j === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      root.classList.toggle('pro', slides[current].dataset.kind === 'pro');
      root.classList.toggle('personal', slides[current].dataset.kind === 'personal');
      const s = slides[current].dataset;
      if (cta) {
        cta.href = s.href ?? '#';
        cta.textContent = s.cta ?? '';
        cta.setAttribute('aria-label', s.ctaLabel ?? '');
        cta.toggleAttribute('data-jump', s.ctaJump === 'true');
      }
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dots.forEach((d, j) => d.addEventListener('click', () => show(j)));

    // Swipe on touch.
    let startX = 0;
    let startY = 0;
    root.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
    });

    syncVideos();
  });
</script>
