---
// Renders text with Markdown-style links: "Published at [AAAI-26](https://doi.org/...)".
// Square brackets without a (url) after them stay as they are, so [placeholders] still show.
interface Props {
  text: string;
}
const { text } = Astro.props;
const parts: (string | { label: string; href: string })[] = [];
const re = /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g;
let last = 0;
for (const m of text.matchAll(re)) {
  parts.push(text.slice(last, m.index));
  parts.push({ label: m[1], href: m[2] });
  last = m.index + m[0].length;
}
parts.push(text.slice(last));
---

{parts.map((p) => (typeof p === 'string' ? p : <a href={p.href}>{p.label}</a>))}
