---
// Orange 4-point spark used before section headers and the quote.
interface Props {
  size?: number;
}
const { size = 18 } = Astro.props;
---

<svg class="spark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <path
    d="M12 1.5 C12.9 7.6 16.4 11.1 22.5 12 C16.4 12.9 12.9 16.4 12 22.5 C11.1 16.4 7.6 12.9 1.5 12 C7.6 11.1 11.1 7.6 12 1.5 Z"
    fill="var(--orange)"></path>
</svg>

<style>
  .spark {
    flex: none;
  }
</style>
